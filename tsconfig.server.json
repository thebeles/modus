{
  "compilerOptions": {
    "target": "ES2023", "module": "commonjs", "moduleResolution": "node",
    "strict": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "esModuleInterop": true, "skipLibCheck": true, "outDir": "dist", "rootDir": ".",
    "sourceMap": true
  },
  "include": ["apps/api/**/*.ts", "apps/worker/**/*.ts", "packages/**/*.ts", "prisma/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}

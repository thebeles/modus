{
  "name": "do-rezultata",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB,WORKER \"pnpm dev:api\" \"pnpm --filter @kontur/web dev\" \"pnpm worker\"",
    "dev:api": "pnpm --filter @kontur/api dev",
    "worker": "pnpm --filter @kontur/api worker",
    "build": "pnpm --filter @kontur/api build && pnpm --filter @kontur/web build",
    "typecheck": "pnpm --filter @kontur/api typecheck && pnpm --filter @kontur/web typecheck",
    "lint": "eslint backend frontend",
    "test": "pnpm --filter @kontur/api test",
    "test:integration": "pnpm --filter @kontur/api test:integration",
    "test:e2e": "pnpm --filter @kontur/web test:e2e",
    "db:migrate": "pnpm --filter @kontur/api db:migrate",
    "db:seed": "pnpm --filter @kontur/api db:seed",
    "db:admin": "pnpm --filter @kontur/api db:admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.3"
  }
}
